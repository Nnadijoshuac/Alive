# Never commit a funded key or the ALIVE verifier private key.
DEPLOYER_PRIVATE_KEY=0xYOUR_DEPLOYER_PRIVATE_KEY
# Required outside localhost: public address derived from ALIVE_VERIFIER_PRIVATE_KEY.
# VERIFIER_ADDRESS=0xAUTHORIZED_VERIFIER_ADDRESS

LOCAL_RPC_URL=http://127.0.0.1:8545
X_LAYER_TESTNET_RPC_URL=https://testrpc.xlayer.tech/terigon
X_LAYER_MAINNET_RPC_URL=https://rpc.xlayer.tech

# MockUSDT is deployed automatically on localhost. Opt in explicitly elsewhere.
DEPLOY_MOCK_USDT=false

# RWA Policy Vault V1. Local deployment falls back to Hardhat account 1.
# RWA_STRATEGY_SIGNER=0xAUTHORIZED_STRATEGY_SIGNER
# The address ALIVE's intelligence service signs eligibility verdicts with
# (services/intelligence's ELIGIBILITY_SIGNER_PRIVATE_KEY, public half).
# Local deployment falls back to Hardhat account 2.
# RWA_ELIGIBILITY_SIGNER=0xAUTHORIZED_ELIGIBILITY_SIGNER
# Demo RWA assets are opt-in outside localhost and have no real-world backing.
DEPLOY_RWA_MOCKS=false
ALLOW_PUBLIC_DEMO_DEPLOYMENT=false
