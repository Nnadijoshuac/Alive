# ALIVE local development template
#
# This file is safe to commit because it contains no usable private keys or
# deployment addresses. Copy it to .env, fill the local-only values, then load
# it into the shell that starts pnpm. Next.js may instead read the public subset
# from apps/web/.env.local, while Hardhat reads packages/contracts/.env.

# V2 RWA intelligence and policy configuration
#
# The service boundary and provider modes are implemented locally; setting
# these values does not prove a live-model or live-market integration.
# `disabled` is the honest zero-cost default for the AI compiler.
INTELLIGENCE_HOST=127.0.0.1
INTELLIGENCE_PORT=4200
INTELLIGENCE_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
INTELLIGENCE_DATABASE_URL=./storage/database/intelligence.sqlite
RWA_CATALOG_PATH=./data/rwa-catalog/catalog.demo.json
RWA_SOURCE_DOCUMENTS_PATH=./data/source-documents
LLM_PROVIDER=disabled
LLM_MODEL=
LLM_BASE_URL=http://127.0.0.1:11434
LLM_API_KEY=
LLM_TIMEOUT_MS=30000

# Eligibility verdict signer (POST /api/assets/:assetId/publish-verdict).
# Server-only key -- never expose it through a NEXT_PUBLIC_ variable. All
# three values must be set together, or all left blank (unconfigured =
# publish-verdict returns 503, every other route still works). This is the
# authorized signer AliveEligibilityRegistry.sol trusts on X Layer; rotate
# it via the contract's onlyOwner setAuthorizedSigner, not by editing this
# file after deployment.
ELIGIBILITY_SIGNER_PRIVATE_KEY=
ELIGIBILITY_CHAIN_ID=
ELIGIBILITY_REGISTRY_ADDRESS=
ELIGIBILITY_ATTESTATION_TTL_SECONDS=900

# The demo provider must label every value as demo/synthetic or dated snapshot
# data. It must never be presented as a live quote.
MARKET_DATA_PROVIDER=demo
DEMO_MARKET_DATA_ENABLED=true

# Optional server-only Chainlink Data Streams adapter. No credential is exposed
# through NEXT_PUBLIC_ variables. Asset/feed mappings remain reviewed config.
CHAINLINK_DATA_STREAMS_ENABLED=false
CHAINLINK_DATA_STREAMS_USERNAME=
CHAINLINK_DATA_STREAMS_PASSWORD=
CHAINLINK_DATA_STREAMS_ENDPOINT=https://api.dataengine.chain.link
CHAINLINK_DATA_STREAMS_WS_ENDPOINT=wss://ws.dataengine.chain.link
CHAINLINK_DATA_STREAMS_FEED_IDS_JSON={}
CHAINLINK_DATA_STREAMS_DECIMALS_JSON={}

# V2 strategy signing is not wired to a public deployment yet. Keep any future
# key server-only and leave it blank until a bounded EIP-712 service exists.
ALIVE_STRATEGY_SIGNER_PRIVATE_KEY=

# Runtime
NODE_ENV=development
DEMO_MODE=true
# Required by POST /api/demo/reset. Leave blank to disable destructive reset.
DEMO_RESET_TOKEN=

# Legacy V1 physical verifier and local persistence
# These settings keep the archived regression runnable; they do not configure
# V2 RWA intelligence.
VERIFIER_HOST=127.0.0.1
VERIFIER_PORT=4100
VERIFIER_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
NEXT_PUBLIC_VERIFIER_URL=http://127.0.0.1:4100
DATABASE_URL=./storage/database/alive.sqlite
# Demo reset is deliberately limited to a dedicated descendant of ./storage.
# Keep this path there if reset is required; an external path will not be deleted.
EVIDENCE_STORAGE_PATH=./storage/evidence
VERIFICATION_SESSION_TTL_SECONDS=300
ATTESTATION_TTL_SECONDS=300
ALIVE_MAX_IMAGE_BYTES=8388608

# EIP-712 wallet authorization and short-lived resource capabilities.
# Audience must be the canonical verifier origin validated by clients. The auth
# chain must match the chain the wallet believes it is authorizing.
ALIVE_AUTH_AUDIENCE=http://127.0.0.1:4100
ALIVE_AUTH_CHAIN_ID=31337
WALLET_AUTH_TTL_SECONDS=120
REGISTRATION_CAPABILITY_TTL_SECONDS=1800

# Optional zero-cost local enrichment. A neural run may download model files
# into the library cache; models and captures must never be committed.
ALIVE_ENABLE_OCR=false
ALIVE_ENABLE_NEURAL_EMBEDDING=false
ALIVE_NEURAL_MODEL=Xenova/clip-vit-base-patch32

# Verifier signing. Generate a dedicated development key and keep it server-only.
# The address derived from this key must equal the registry's authorized verifier.
ALIVE_VERIFIER_PRIVATE_KEY=0xYOUR_DEVELOPMENT_VERIFIER_PRIVATE_KEY
ALIVE_CHAIN_ID=31337
ALIVE_ATTESTATION_REGISTRY_ADDRESS=

# Browser chain configuration. These legacy address names still drive V1. New
# V2 addresses must remain blank until the matching contracts are deployed.
# Use xlayer-testnet only after a real complete deployment exists.
NEXT_PUBLIC_CHAIN_ENV=local
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_RWA_ASSET_REGISTRY_ADDRESS=
NEXT_PUBLIC_POLICY_REGISTRY_ADDRESS=
NEXT_PUBLIC_STRATEGY_VERIFIER_ADDRESS=
NEXT_PUBLIC_RWA_ROUTER_ADDRESS=
NEXT_PUBLIC_RWA_VAULT_ADDRESS=
NEXT_PUBLIC_RWA_VAULT_FACTORY_ADDRESS=
NEXT_PUBLIC_RWA_CASH_TOKEN_ADDRESS=
NEXT_PUBLIC_RWA_FAUCET_ADDRESS=
NEXT_PUBLIC_ASSET_REGISTRY_ADDRESS=
NEXT_PUBLIC_ATTESTATION_REGISTRY_ADDRESS=
NEXT_PUBLIC_ESCROW_ADDRESS=
NEXT_PUBLIC_TEST_TOKEN_ADDRESS=

# Contract deployment. Leave private keys empty for the local Hardhat node.
# For X Layer, use a dedicated funded testnet key and never expose it to Next.js.
DEPLOYER_PRIVATE_KEY=
LOCAL_RPC_URL=http://127.0.0.1:8545
X_LAYER_TESTNET_RPC_URL=https://testrpc.xlayer.tech/terigon
X_LAYER_MAINNET_RPC_URL=https://rpc.xlayer.tech
DEPLOY_MOCK_USDT=false

# V2 RWA demo deployment. Local Hardhat falls back to account 1 for the public
# signer address. Mocks are synthetic and require an additional explicit guard
# before any public-network deployment.
RWA_STRATEGY_SIGNER=
DEPLOY_RWA_MOCKS=false
ALLOW_PUBLIC_DEMO_DEPLOYMENT=false

# VERIFIER_ADDRESS is optional on localhost, where account 1 is used by default.
# It is required for X Layer and must match ALIVE_VERIFIER_PRIVATE_KEY.
# VERIFIER_ADDRESS=0xAUTHORIZED_VERIFIER_ADDRESS

# Advanced: override the complete score policy with strict JSON. If unset, the
# policy in packages/shared/src/scoring.ts is used.
# ALIVE_SCORE_POLICY_JSON={"thresholds":...}
