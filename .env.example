# Runtime
NODE_ENV=development
DEMO_MODE=true
DEMO_DEBUG=true
NEXT_PUBLIC_DEMO_MODE=true

# Local services
DATABASE_URL=./storage/database/alive.sqlite
EVIDENCE_STORAGE_PATH=./storage/evidence
VERIFIER_PORT=4100
NEXT_PUBLIC_VERIFIER_URL=http://localhost:4100

# Verifier signing. Generate a dedicated development key. Never commit the value.
ALIVE_VERIFIER_PRIVATE_KEY=0xYOUR_DEVELOPMENT_VERIFIER_PRIVATE_KEY

# X Layer network configuration
NEXT_PUBLIC_CHAIN_ENV=xlayer-testnet
NEXT_PUBLIC_CHAIN_ID=1952
NEXT_PUBLIC_XLAYER_RPC_URL=https://testrpc.xlayer.tech/terigon
NEXT_PUBLIC_XLAYER_EXPLORER_URL=https://www.okx.com/web3/explorer/xlayer-test

# Deployment addresses. Filled by deployment scripts.
NEXT_PUBLIC_ALIVE_REGISTRY_ADDRESS=
NEXT_PUBLIC_ATTESTATION_REGISTRY_ADDRESS=
NEXT_PUBLIC_ESCROW_ADDRESS=
NEXT_PUBLIC_MOCK_USDT_ADDRESS=

# Deployment only. Never expose this to the browser or commit it.
DEPLOYER_PRIVATE_KEY=0xYOUR_DEVELOPMENT_DEPLOYER_PRIVATE_KEY
