{
  "name": "@alive/verifier",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "prebuild": "pnpm --filter @alive/shared build",
    "build": "tsc -p tsconfig.build.json",
    "prelint": "pnpm --filter @alive/shared build",
    "lint": "tsc -p tsconfig.json --noEmit",
    "pretypecheck": "pnpm --filter @alive/shared build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm --filter @alive/shared build",
    "test": "vitest run",
    "smoke:local": "pnpm build && pnpm --filter @alive/contracts compile && node scripts/local-protocol-smoke.mjs"
  },
  "dependencies": {
    "@alive/shared": "workspace:*",
    "@fastify/cors": "^11.1.0",
    "better-sqlite3": "^12.2.0",
    "fastify": "^5.6.0",
    "sharp": "^0.34.3",
    "viem": "^2.37.6",
    "zod": "^3.25.76"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^3.7.2",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "vitest": "^3.2.4"
  }
}
