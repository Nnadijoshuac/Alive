{
  "name": "alive",
  "version": "0.1.0",
  "private": true,
  "description": "ALIVE turns observable physical asset state into signed onchain attestations.",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @alive/verifier --filter @alive/web dev",
    "dev:web": "pnpm --filter @alive/web dev",
    "dev:verifier": "pnpm --filter @alive/verifier dev",
    "chain": "pnpm --filter @alive/contracts node",
    "deploy:local": "pnpm --filter @alive/contracts deploy:local",
    "deploy:testnet": "pnpm --filter @alive/contracts deploy:testnet",
    "seed:demo": "pnpm --filter @alive/web seed:demo",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:contracts": "pnpm --filter @alive/contracts test",
    "test:verifier": "pnpm --filter @alive/verifier test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  }
}
