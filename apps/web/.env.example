# Public chain configuration. Never put provider credentials or private keys in
# this file. Only contract addresses and public endpoints belong here.
#
# Do not hand-copy addresses. Generate apps/web/.env.local straight from a
# verified deployment record instead:
#   pnpm --filter @alive/contracts sync:web-env 1952   # X Layer Testnet
#   pnpm --filter @alive/contracts sync:web-env 31337  # local chain
NEXT_PUBLIC_INTELLIGENCE_URL=http://127.0.0.1:4200
NEXT_PUBLIC_CHAIN_ENV=local
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_RWA_ASSET_REGISTRY_ADDRESS=
NEXT_PUBLIC_ELIGIBILITY_REGISTRY_ADDRESS=
NEXT_PUBLIC_POLICY_REGISTRY_ADDRESS=
NEXT_PUBLIC_STRATEGY_VERIFIER_ADDRESS=
NEXT_PUBLIC_RWA_ROUTER_ADDRESS=
NEXT_PUBLIC_RWA_VAULT_ADDRESS=
NEXT_PUBLIC_RWA_VAULT_FACTORY_ADDRESS=
NEXT_PUBLIC_RWA_CASH_TOKEN_ADDRESS=
NEXT_PUBLIC_RWA_FAUCET_ADDRESS=

# Primary demo asset for the verification gateway walkthrough.
NEXT_PUBLIC_DEMO_ASSET_ID=ttbill-a
NEXT_PUBLIC_DEMO_ASSET_TOKEN_ADDRESS=

# Legacy V1 physical-state configuration retained during the archive transition.
NEXT_PUBLIC_VERIFIER_URL=http://127.0.0.1:4100
NEXT_PUBLIC_ALIVE_AUTH_AUDIENCE=http://127.0.0.1:4100
NEXT_PUBLIC_ASSET_REGISTRY_ADDRESS=
NEXT_PUBLIC_ATTESTATION_REGISTRY_ADDRESS=
NEXT_PUBLIC_ESCROW_ADDRESS=
NEXT_PUBLIC_TEST_TOKEN_ADDRESS=
